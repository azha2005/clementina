590 v40        ; si no, trampa
370 4    (13   ; St = r - 5
290 v40        ; si r >= 5, trampa

(Validar cantidad: 1 <= k <= fila[r - 1])
001 12         ; B1 = r - 1
200 12+
330 1          ; S = St = k - 1
290 v14        ; pasa si 1 <= k <= 512
590 v40
271 10   (14   ; St = k - 1 - fila[B1]
290 v40        ; si St >= 0 => k > fila[B1], trampa

(Aplicar jugada humana)
201 10         ; S = fila[B1]
230 12+        ; S = fila[B1] - k
211 10         ; guardar resto

(Verificar si gano el humano)
200 10
