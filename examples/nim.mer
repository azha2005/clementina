106 1    (8    ; X != 0 => posicion mala para el segundo jugador
102 v9
590 v81        ; perforar MI POSICION ES MALA PERO CUIDESE
106 17   (9    ; perforar espacio separador
102 v10
590 v81

(--- Turno del jugador humano ---)
